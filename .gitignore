# 忽略私密配置（含 API key）
.env

# Python 编译产物
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# LLM 响应缓存（个人 Vault 私有）
.kis-cache/

# 运行状态 / 增量 checkpoint（个人 Vault 私有，勿分发）
.kis_state.json

# 用户分类覆盖与分类目录数据（个人 Vault 私有）
catalog.json
.kis_pending_categories.json

# 脚本运行日志
distill.log
distill.error.log

# 系统 / IDE 元数据
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# macOS LaunchAgents 生成产物（含本机绝对路径，勿分发）
*.plist.generated
scripts/*.plist

# 测试/临时产物
*.log
*.tmp
